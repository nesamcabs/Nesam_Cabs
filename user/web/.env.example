# Optional. The website reads the same variable names as ../app, so one set works for both.
# With none of these set it talks to the default NESAM Firebase project and Firebase callables.

# The NESAM booking server (Vercel API). REQUIRED: without it the site calls Firebase Cloud Functions, which are not
# deployed, so fares never load ("The server could not complete the request"). Set it on Vercel too, then redeploy.
EXPO_PUBLIC_API_URL=https://nesam-travels-api.vercel.app

# Self-hosted place search / routing:
# EXPO_PUBLIC_GEOCODER_URL=https://photon.example.com
# EXPO_PUBLIC_ROUTING_URL=https://osrm.example.com

# Map tiles (any XYZ raster tile server; keep the attribution it requires):
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
# VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors © CARTO

# Referrer-restricted browser key. Enable Maps JavaScript API only for map display;
# place search, geocoding and routing use the private server key through the API.
# VITE_GOOGLE_MAPS_API_KEY=

# Firebase project override (defaults to the NESAM project):
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Local Firebase emulators (never for a production build):
# EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-nesam

# Google Search Console Site Verification (Meta Tag Method):
# VITE_GOOGLE_SITE_VERIFICATION=your-google-site-verification-token

# ── Groq AI Chatbot ─────────────────────────────────────────────────────────
# Configure GROQ_API_KEY on the shared server (functions/.env), never as VITE_*
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
